# Copy to repo root: cp .env.example .env

# Default model-tier pool. Swap provider/model by editing the tier catalog and
# setting the matching key/base-url envs; do not add provider-specific code.
DASHSCOPE_API_KEY=your_dashscope_api_key_here
AICODE007_API_KEY=your_aicode007_api_key_here
AICODE007_BASE_URL=https://api.aicode007.com/v1
# Optional: HTTP proxy for aicode007 only (SOCKS all_proxy breaks litellm)
# AICODE007_HTTP_PROXY=http://127.0.0.1:7890

.env
.env.*
!.env.example

# Python
__pycache__/
**/__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
**/.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
.venv/
venv/

# IDE / agent tooling
.cursor/
.claude/
.vscode/
.idea/
skills-lock.json

# External deps / localized runtime dependencies.
# Keep these local for speed; resolvers fail fast if they are missing.
paper1/external/mini-swe-agent/
paper1/external/mini-swe-agent
paper1/external/SWE-agent/
paper1/code/external/mini-swe-agent/
paper1/code/external/mini-swe-agent
paper1/code/external/SWE-agent/

# Local data & experiment artifacts
paper1/data/
paper1/code/data/

# SWE-bench clones (legacy explicit paths kept for clarity)
paper1/data/SWE-bench/
paper1/data/experiments/
paper1/data/repo_cache/
paper1/data/runs/
paper1/data/swebench_lite_export/

# Generated outputs
*.jsonl
*.log

# Runtime / crash artifacts
paper1/logs/
paper1/tmp/
paper1/code/tmp/
paper1/code/logs/
paper1/misc/deck/.agents/
paper1/misc/deck/**/.agents/
paper1/misc/deck/**/.claude/

# Test / coverage artifacts
.coverage
htmlcov/
.tox/
.nox/
.hypothesis/

# Editor swap files
*~
*.swp
*.swo

# Local paper/reference PDFs. Summaries and matrices belong in docs/; raw PDFs
# stay local unless explicitly requested.
paper1/misc/*.pdf
paper1/misc/**/*.pdf

# Node / slide decks
node_modules/
**/node_modules/
.pnpm-store/
**/.pnpm-store/
dist/
**/dist/
.netlify/
**/.netlify/
.next/
**/.next/
playwright-report/
**/playwright-report/
test-results/
**/test-results/

# OS
.DS_Store
Thumbs.db
core
core.*

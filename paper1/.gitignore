# paper1 BudgetFlow runtime artifacts
# NOTE: parent AgentOS/.gitignore covers broad Python, node, data, and runtime
# artifacts. This file keeps paper1-specific paths explicit.

# Runtime worktrees (now default to /tmp/budgetflow_worktrees via env/CLI,
# but NFS fallback may still write here)
data/repo_cache/worktrees/

# Cross-process lock files
data/repo_cache/.locks/

# Experiment run artifacts (heartbeat, checkpoint, JSONL)
data/runs/*.heartbeat.json
data/runs/*.checkpoint.json
data/runs/*.tmp

# Large trace dumps
*.trace.jsonl
*.trace.json

# Runtime logs and temp dirs (build, evaluation, scratch)
logs/
tmp/
code/logs/
code/tmp/

# Deck-local agent skill copies (source decks stay tracked)
misc/deck/.agents/
misc/deck/**/.agents/
misc/deck/**/.claude/

# IDE / editor
.vscode/
.idea/

# Local external dependencies
external/mini-swe-agent/
external/SWE-agent/
code/external/mini-swe-agent/
code/external/SWE-agent/

# LaTeX build byproducts
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.fdb_latexmk
paper/*.fls
paper/*.log
paper/*.out
paper/*.toc
paper/*.synctex.gz

# Deliberately NOT ignored — AutoResearch evidence ledger:
#   .autoresearch/issues/
#   .autoresearch/workflows/
#   .autoresearch/goals/
#   docs/reports/*.md
